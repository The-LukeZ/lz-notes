{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lz-notes-consumer",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// Required secret. Set with `wrangler secret put MISTRAL_API_KEY`. Declaring
	// it here validates its presence on deploy and drives type generation; the
	// value is never stored in config. For local dev put it in consumer/.dev.vars.
	"secrets": {
		"required": ["MISTRAL_API_KEY"]
	},
	// D1 database — shared with the web worker. This database_id MUST match the
	// one in web/wrangler.jsonc exactly (it's one shared database).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lz-notes-db",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID"
		}
	],
	// R2 bucket for uploaded audio — shared with the web worker.
	"r2_buckets": [
		{
			"binding": "AUDIO_BUCKET",
			"bucket_name": "lz-notes-audio"
		}
	],
	// Queue consumer: one transcription job per invocation. max_batch_size: 1 is
	// deliberate — each job is a long transcription call, so batching buys
	// nothing and complicates ack/retry logic (PLAN §5).
	"queues": {
		"consumers": [
			{
				"queue": "lz-notes-transcription-jobs",
				"max_batch_size": 1,
				"max_retries": 3,
				"dead_letter_queue": "lz-notes-transcription-jobs-dlq"
			}
		]
	}
}
